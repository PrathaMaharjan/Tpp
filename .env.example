# Copy to .env and fill in for your environment.
#   cp .env.example .env
#
# All values here are read at BUILD time by Next.js (NEXT_PUBLIC_*),
# so a deploy must have them set before `next build` runs.

# ── CMS ──────────────────────────────────────────────────────────
# Base URL of the CMS that serves doctors, treatments and blog posts.
#
# Local development: the CMS dev server runs on :3002.
#   Do NOT use :3000 or :3001 here. Those are this site's own dev
#   server, and pointing at them makes the app fetch itself.
#
# Production: must be a publicly reachable URL, not localhost. These
# requests run in the browser, so the CMS also needs to allow this
# site's origin via CORS.
NEXT_PUBLIC_CMS_URL=http://localhost:3002

# Site slug registered in the CMS. Endpoints are /api/<slug>/...
NEXT_PUBLIC_SITE_SLUG=tpp

# ── Legacy aliases ───────────────────────────────────────────────
# Older code paths read these names. Keep them in step with the two
# values above until those references are removed.
NEXT_PUBLIC_POS_API_URL=http://localhost:3002
NEXT_PUBLIC_TENANT_SLUG=tpp

# ── Site ─────────────────────────────────────────────────────────
# Canonical public URL. Used by metadataBase, sitemap.xml, robots.txt
# and the clinic structured data, so it must match the live domain or
# canonical tags and OG links will point somewhere wrong.
NEXT_PUBLIC_SITE_URL=https://tppcare.com
